{
  "name": "vektor-tanstack-react-start",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "nub run build && wrangler deploy",
    "preflight": "node scripts/ensure-dev-vars.mjs",
    "reset:d1": "node scripts/reset-local-d1.mjs",
    "seed:admin": "nub scripts/seed-admin.ts",
    "deploy:preview": "nub run build && wrangler versions upload",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "check": "nub run typecheck && nub run lint && nub run format:check && nub run test:unit && nub run preflight && nub run test:e2e && nub run build",
    "clean": "rm -rf .output .tanstack .wrangler coverage dist node_modules/.vite playwright-report test-results",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "nub run test:unit && nub run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "nub run preflight && nub run reset:d1 && nub run build && nubx playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "1.168.46",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "openai": "^7.5.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.53.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/react-devtools": "^0.10.10",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "nub@0.7.5",
  "allowBuilds": {
    "esbuild": true,
    "lightningcss": true,
    "workerd": true
  }
}
