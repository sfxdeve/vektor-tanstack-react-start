{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vektor-tanstack-react-start",
  "compatibility_date": "2026-08-20",
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
  },
  "triggers": {
    // 08:00 SAST daily reminders (Cloudflare cron triggers run in UTC)
    "crons": ["0 6 * * *"],
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "vektor-storage",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vektor-db",
      "database_id": "391cc875-4123-4b47-bda0-f9b63893c232",
      "migrations_dir": "drizzle",
    },
  ],
}
