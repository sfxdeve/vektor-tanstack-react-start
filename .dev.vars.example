# Local development secrets for Cloudflare Workers / Better Auth.
# Copy to .dev.vars and fill in values. Never commit .dev.vars with real secrets.

BETTER_AUTH_SECRET="development-secret-key-at-least-32-chars-long"
# Preview/e2e default is :4173. `nub run dev` is :5173 — both origins are
# trusted in src/lib/auth/auth.ts so either port works locally.
BETTER_AUTH_URL="http://127.0.0.1:5173"
APP_URL="http://127.0.0.1:5173"

# Captures outgoing email in the in-memory dev mailbox (/api/dev/mailbox)
# instead of sending it. Local development and e2e only — never set this in
# production.
DEV_MAILBOX="1"

# Local/e2e only: return a deterministic tender extraction instead of calling
# OpenAI via AI Gateway, so the analyze journey is reproducible without keys.
# Never set this in production.
DEV_AI_STUB="1"

# EFT bank details shown on billing requests. In production these are set via
# `wrangler secret put EFT_*`; locally they are plain vars. These demo FNB
# details are for dev/e2e display only — no money moves over them.
EFT_BANK_NAME="First National Bank"
EFT_ACCOUNT_HOLDER="Vektor (Pty) Ltd"
EFT_ACCOUNT_NUMBER="62712345678"
EFT_BRANCH_CODE="250655"
EFT_ACCOUNT_TYPE="Cheque"

# Resend email delivery. Required in production; leave unset locally so the
# dev mailbox above takes over.
# RESEND_API_KEY="re_..."
# SENDER_EMAIL="no-reply@vektorhq.co.za"
# SENDER_NAME="Vektor"
# EMAIL_FROM="Vektor <no-reply@vektorhq.co.za>"

# AI / Tender Analysis (uncomment for real local AI calls). Gateway and
# account ID are a pair: configure both or neither.
# OPENAI_API_KEY="sk-..."
# AI_GATEWAY_ID="my-ai-gateway"
# CLOUDFLARE_ACCOUNT_ID="0123456789abcdef0123456789abcdef"
